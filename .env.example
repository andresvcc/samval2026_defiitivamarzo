# Configuración local opcional. Los valores privados se guardan en .env.
# Los puertos y rutas locales tienen sus valores predeterminados en el código.
SAMVAL_PORT=
SAMVAL_STATIC_DIR=
SAMVAL_DATA_DIR=
SAMVAL_ALLOWED_ORIGINS=
SAMVAL_IP_HASH_SALT=
SAMVAL_FORM_WEBHOOK_URL=
# Verificador de /v: NATS de gestión de Admin (tls://agentes.samval.org:4222), usuario fijo document-verifier.
# La contraseña es secreta; Admin guarda sólo su SHA-256. La CA es el PEM público del broker (\n escapados valen).
SAMVAL_VERIFIER_NATS_URL=
SAMVAL_VERIFIER_NATS_PASSWORD=
SAMVAL_VERIFIER_NATS_CA_PEM=
# Sólo fuera de producción: orígenes extra permitidos para /api/verify (producción: samval.org y www).
SAMVAL_VERIFY_ORIGINS=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_TO_EMAIL=
BREVO_TO_NAME=
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
VITE_SAMVAL_API_BASE_URL=
VITE_GA_MEASUREMENT_ID=
